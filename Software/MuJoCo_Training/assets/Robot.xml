  <actuator>
    <position name="m_hip_middle" joint="base_hip_middle_joint" kp="300" />
    <position name="m_hip_l_yaw" joint="base_hip_left_joint" kp="1000" />
    <position name="m_hip_l_roll" joint="hip_hip_left_joint" kp="2000" />
    <position name="m_hip_l_pitch" joint="hip_knee_left_joint" kp="1000" />
    <position name="m_ankle_l_p" joint="knee_ankle_left_joint" kp="1000" />
    <position name="m_ankle_l_r" joint="ankle_ankle_left_joint" kp="1000" />
    <position name="m_hip_r_yaw" joint="base_hip_right_joint" kp="1000" />
