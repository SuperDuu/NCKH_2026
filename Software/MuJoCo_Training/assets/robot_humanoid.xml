            <joint name="shoulder_shoulder_left_joint" pos="0 0 0" axis="0 0 -1" range="-1.0472 1.0472"/>
            <geom type="mesh" rgba="0.698039 0.698039 0.698039 1" mesh="shoulder_shoulder_left_link"/>
            <body name="shoulder_elbow_left_link" pos="0 -0.0636218 0.0261725">
              <joint name="shoulder_elbow_left_joint" pos="0 0 0" axis="0 0 -1" range="-1.3963 1.3963"/>
              <geom type="mesh" rgba="0.698039 0.698039 0.698039 1" mesh="shoulder_elbow_left_link"/>
            </body>
          </body>
        </body>

        <body name="hip_shoulder_right_link" pos="0.108 0.016 0.1093" quat="0 0 0.707107 0.707107">
          <joint name="hip_shoulder_right_joint" pos="0 0 0" axis="0 0 -1" range="-0.17453 1.2217"/>
          <geom type="mesh" rgba="0.698039 0.698039 0.698039 1" mesh="hip_shoulder_right_link"/>
          <body name="shoulder_shoulder_right_link" pos="-0.0156725 -0.0168782 -0.0274" quat="0.707107 0 0.707107 0">
            <joint name="shoulder_shoulder_right_joint" pos="0 0 0" axis="0 0 -1" range="-1.0472 1.0472"/>
            <geom type="mesh" rgba="0.698039 0.698039 0.698039 1" mesh="shoulder_shoulder_right_link"/>
            <body name="shoulder_elbow_right_link" pos="0 -0.0636218 0.0261725">
              <joint name="shoulder_elbow_right_joint" pos="0 0 0" axis="0 0 -1" range="-1.3963 1.3963"/>
              <geom type="mesh" rgba="0.698039 0.698039 0.698039 1" mesh="shoulder_elbow_right_link"/>
            </body>
          </body>
        </body>
      </body> </body> </worldbody>

  <actuator>
    <position name="act_base_hip_left" joint="base_hip_left_joint"/>
    <position name="act_hip_hip_left" joint="hip_hip_left_joint"/>
    <position name="act_hip_knee_left" joint="hip_knee_left_joint"/>
    <position name="act_knee_ankle_left" joint="knee_ankle_left_joint"/>
    <position name="act_ankle_ankle_left" joint="ankle_ankle_left_joint"/>
    <position name="act_base_hip_right" joint="base_hip_right_joint"/>
    <position name="act_hip_hip_right" joint="hip_hip_right_joint"/>
    <position name="act_hip_knee_right" joint="hip_knee_right_joint"/>
    <position name="act_knee_ankle_right" joint="knee_ankle_right_joint"/>
    <position name="act_ankle_ankle_right" joint="ankle_ankle_right_joint"/>
    <position name="act_base_hip_middle" joint="base_hip_middle_joint"/>
    <position name="act_hip_shoulder_left" joint="hip_shoulder_left_joint"/>
