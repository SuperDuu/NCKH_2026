    <implicitSpringDamper>true</implicitSpringDamper>
    <friction>0.1</friction>
    <damping>0.05</damping>
  </gazebo>
  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>shoulder_elbow_right_joint</joint_name>
      <topic>/model/humanoid_robot/joint/shoulder_elbow_right_joint/cmd_pos</topic>
      <p_gain>200</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>5</d_gain>
      <cmd_max>20.0</cmd_max>
      <cmd_min>-20.0</cmd_min>
      <velocity_max>6.0</velocity_max>
    </plugin>
  </gazebo>
</robot>
